meta {
  name: Chat - save visitor name
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/visitor/identity
  body: json
  auth: none
}

body:json {
  {
    "tenantId": "self",
    "sessionId": "sess-demo-1",
    "visitorSecret": "{{visitorSecret}}",
    "name": "Dana"
  }
}

docs {
  The site must enable visitor identity collection first. Use the session-bound
  visitorSecret created by the widget; the operator's session ID is insufficient.
  A successful write updates the name shown in Buttr and the web inbox.
}
